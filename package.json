{
  "name": "trippilot",
  "version": "1.0.0",
  "description": "TripPilot — AI-Powered Adaptive Travel Planner",
  "main": "server/dist/index.js",
  "scripts": {
    "install:all": "npm --prefix client install && npm --prefix server install",
    "build:client": "npm --prefix client run build",
    "build:server": "npm --prefix server run build",
    "build": "npm --prefix client install && npm --prefix client run build && npm --prefix server install && npm --prefix server run build",
    "start": "node server/dist/index.js",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "test": "npm --prefix server test"
  },
  "keywords": ["travel", "ai", "gemini", "planner", "adaptive"],
  "author": "TripPilot Team",
  "license": "MIT"
}

